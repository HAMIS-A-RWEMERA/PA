{
  "entities": {
    "Goal": {
      "title": "Goal",
      "description": "Yearly goals",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "target": { "type": "string" },
        "goalDescription": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["userId", "target", "goalDescription"]
    },
    "Reflection": {
      "title": "Reflection",
      "description": "Daily reflection",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "content": { "type": "string" }
      },
      "required": ["userId", "date", "content"]
    },
    "Task": {
      "title": "Task",
      "description": "Weekly to-do list items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string" },
        "completed": { "type": "boolean" },
        "goalId": { "type": "string" },
        "reflection": { "type": "string" },
        "skills": { "type": "array" },
        "date": { "type": "string" },
        "pinned": { "type": "boolean" },
        "color": { "type": "string" },
        "subtasks": { "type": "array" },
        "tags": { "type": "array" },
        "isArchived": { "type": "boolean" }
      },
      "required": ["userId", "description", "completed"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Daily expenses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["userId", "amount", "category"]
    },
    "Income": {
      "title": "Income",
      "description": "Income records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["userId", "amount", "category"]
    },
    "TimeEntry": {
      "title": "TimeEntry",
      "description": "Focus timer tracking entries",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "taskId": { "type": "string" },
        "startTime": { "type": "object" },
        "endTime": { "type": "object" }
      },
      "required": ["userId", "taskId", "startTime"]
    },
    "EnergyLog": {
      "title": "EnergyLog",
      "description": "Daily energy level and wellness audits",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "energyLevel": { "type": "number" },
        "tags": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["userId", "energyLevel"]
    },
    "CVProfile": {
      "title": "CVProfile",
      "description": "Comprehensive Curriculum Vitae, career history, education, skills, and certifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "title": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "summary": { "type": "string" },
        "experiences": { "type": "array" },
        "education": { "type": "array" },
        "certifications": { "type": "array" },
        "skillCategories": { "type": "array" },
        "projects": { "type": "array" },
        "updatedAt": { "type": "object" }
      },
      "required": ["userId", "fullName", "title"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Personal photo gallery, memories, certificates, and milestone pictures",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "caption": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["userId", "title", "imageUrl"]
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "description": "Ancestral family tree member and genealogical heritage record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "relationship": { "type": "string" },
        "generation": { "type": "number" },
        "parentIds": { "type": "array" },
        "spouseName": { "type": "string" },
        "birthYear": { "type": "string" },
        "passedYear": { "type": "string" },
        "isAlive": { "type": "boolean" },
        "birthPlace": { "type": "string" },
        "occupation": { "type": "string" },
        "notesBio": { "type": "string" },
        "branch": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["userId", "fullName", "relationship"]
    },
    "SkillEntry": {
      "title": "SkillEntry",
      "description": "Competency or skill development log and mastery tracker",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "level": { "type": "string" },
        "hoursInvested": { "type": "number" },
        "notes": { "type": "string" },
        "tags": { "type": "array" },
        "date": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["userId", "name"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Synced or imported calendar event from Google Calendar or iCal",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "location": { "type": "string" },
        "source": { "type": "string" },
        "googleEventId": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["userId", "title", "startDate"]
    },
    "FinancialPosition": {
      "title": "FinancialPosition",
      "description": "User liquid balances (Cash, Mobile Money, Bank accounts)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "cashOnHand": { "type": "number" },
        "mobileMoney": { "type": "number" },
        "bankBalance": { "type": "number" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "DebtRecord": {
      "title": "DebtRecord",
      "description": "Two-way debt tracking ledger (debts owed by user or owed to user)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["owed_by_me", "owed_to_me"] },
        "counterparty": { "type": "string" },
        "amount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "dueDate": { "type": "string" },
        "startDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "partially_paid", "settled"] },
        "notes": { "type": "string" }
      },
      "required": ["userId", "type", "counterparty", "amount"]
    },
    "InvestmentRecord": {
      "title": "InvestmentRecord",
      "description": "Investments such as RNIT Iterambere Fund units, NAV tracking, shares, and savings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["rnit_nav", "shares", "savings", "asset"] },
        "name": { "type": "string" },
        "units": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "currentPrice": { "type": "number" },
        "totalInvested": { "type": "number" },
        "currentValue": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["userId", "type", "name"]
    },
    "RecurringCashflow": {
      "title": "RecurringCashflow",
      "description": "Expected receivables and recurring cash inflow or outflow",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["recurring_income", "expected_receivable", "recurring_obligation"] },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "frequency": { "type": "string" },
        "expectedDate": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["userId", "type", "name", "amount"]
    }
  },
  "firestore": {
    "/goals/{goalId}": {
      "schema": "Goal",
      "description": "Goals collection"
    },
    "/reflections/{reflectionId}": {
      "schema": "Reflection",
      "description": "Reflections collection"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks collection"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Expenses collection"
    },
    "/income/{incomeId}": {
      "schema": "Income",
      "description": "Income collection"
    },
    "/skills/{skillId}": {
      "schema": "SkillEntry",
      "description": "Skills and competencies tracking collection"
    },
    "/calendar_events/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Imported and synced calendar events collection"
    },
    "/financial_positions/{posId}": {
      "schema": "FinancialPosition",
      "description": "Current liquid financial positions"
    },
    "/debts/{debtId}": {
      "schema": "DebtRecord",
      "description": "Two-way debt ledger"
    },
    "/investments/{invId}": {
      "schema": "InvestmentRecord",
      "description": "RNIT NAV units, shares, and savings investments"
    },
    "/recurring_cashflows/{cfId}": {
      "schema": "RecurringCashflow",
      "description": "Expected receivables and recurring cashflows"
    },
    "/timeEntries/{entryId}": {
      "schema": "TimeEntry",
      "description": "Time tracking entries collection"
    },
    "/energyLogs/{logId}": {
      "schema": "EnergyLog",
      "description": "Energy logs collection"
    },
    "/cv_profiles/{profileId}": {
      "schema": "CVProfile",
      "description": "User CV and portfolio profile"
    },
    "/gallery/{photoId}": {
      "schema": "GalleryItem",
      "description": "User photo and visual memories gallery"
    },
    "/family_members/{memberId}": {
      "schema": "FamilyMember",
      "description": "Ancestral family tree and heritage members"
    }
  }
}
